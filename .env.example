# WM GeoInject - Environment Variables
# Salin file ini menjadi .env lalu isi nilainya

# API key untuk Ciora Vision (atau model vision lain yang kamu pakai)
WM_API_KEY=sk-contoh-ganti-dengan-api-key-mu

# Endpoint API chat completions
WM_API_ENDPOINT=https://ciora.id/v1/chat/completions

# Folder scratch untuk file sementara (default: ~/.wm_geoinject/scratch)
WM_SCRATCH=

# Base folder yang berisi sub-folder foto (default: folder saat ini)
WM_BASE=

# Daftar folder untuk chain_runner (format JSON array, opsional)
# WM_QUEUE=[["folder1","wm_pipeline2.py"],["folder2","wm_pipeline2.py"]]

# Daftar folder untuk progress (pisahkan koma, opsional)
# WM_FOLDERS=folder1,folder2,folder3

# Model ranking (opsional, pisahkan koma)
# WM_MODEL_PRIMARY=ciora-vision-free
# WM_MODEL_FALLBACK1=dots-studio/dots-3-note-preview
# WM_MODEL_FALLBACK2=ciora-coding-free
